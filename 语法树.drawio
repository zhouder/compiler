        <mxCell id="uXQuWtPGsDaRt33PNCmI-21" parent="1tBlfk9a1Zpckicxz9dx-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#bf9000;align=left;verticalAlign=top;fontSize=22;fontFamily=Times New Roman,SimSun" value="&lt;div&gt;回填说明：&lt;/div&gt;&lt;div&gt;&lt;div&gt;while 条件 i &amp;lt; 3：&lt;/div&gt;&lt;div&gt;真出口 → 顺序进入 L2&lt;/div&gt;&lt;div&gt;假出口 → L6，bp(while.false_list, L6)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;if 条件 a &amp;gt; b：&lt;/div&gt;&lt;div&gt;真出口 → 顺序进入 L3&lt;/div&gt;&lt;div&gt;假出口 → L4，bp(if.false_list, L4)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;then 分支执行完 → L5&lt;/div&gt;&lt;div&gt;else 分支执行完 → L5&lt;/div&gt;&lt;div&gt;循环体末尾 i = i + 1 后跳回 L1&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="380" x="590" y="960" as="geometry" />
        </mxCell>
        <mxCell id="uXQuWtPGsDaRt33PNCmI-23" parent="1tBlfk9a1Zpckicxz9dx-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;align=left;verticalAlign=top;fontSize=22;fontFamily=Consolas,SimSun" value="&lt;div&gt;回填后 IR：&lt;/div&gt;&lt;div&gt;(label, -, -, L1)&lt;/div&gt;&lt;div&gt;(&amp;lt;, i, 3, t1)&lt;/div&gt;&lt;div&gt;(jz, t1, -, L6)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(label, -, -, L2)&lt;/div&gt;&lt;div&gt;(&amp;gt;, a, b, t2)&lt;/div&gt;&lt;div&gt;(jz, t2, -, L4)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(label, -, -, L3)&lt;/div&gt;&lt;div&gt;(=, 1, -, c)&lt;/div&gt;&lt;div&gt;(jmp, -, -, L5)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(label, -, -, L4)&lt;/div&gt;&lt;div&gt;(=, 2, -, c)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(label, -, -, L5)&lt;/div&gt;&lt;div&gt;(+, i, 1, t3)&lt;/div&gt;&lt;div&gt;(=, t3, -, i)&lt;/div&gt;&lt;div&gt;(jmp, -, -, L1)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(label, -, -, L6)&lt;/div&gt;" vertex="1">
