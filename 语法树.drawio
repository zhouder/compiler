        <mxCell id="uXQuWtPGsDaRt33PNCmI-0" parent="1tBlfk9a1Zpckicxz9dx-1" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontFamily=Times New Roman,SimSun" value="第1组：while(){ if(){}else{} } 语法树" vertex="1">
          <mxGeometry height="40" width="1000" x="900" y="400" as="geometry" />
        </mxCell>
        <mxCell id="uXQuWtPGsDaRt33PNCmI-1" parent="1tBlfk9a1Zpckicxz9dx-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;fontSize=22;fontFamily=Times New Roman,SimSun;fontStyle=3" value="示例程序：&lt;br&gt;while (i &amp;lt; 3)&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;{&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;if (a &amp;gt; b)&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;{&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;c = 1;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;}&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;else {&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;c = 2;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;}&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;i = i + 1;&lt;/div&gt;&lt;div&gt;&amp;nbsp;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="275" width="250" x="590" y="400" as="geometry" />
        </mxCell>
        <mxCell id="uXQuWtPGsDaRt33PNCmI-2" parent="1tBlfk9a1Zpckicxz9dx-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f5ff;strokeColor=#01579b;align=left;verticalAlign=middle;fontSize=22;fontFamily=Times New Roman,SimSun;fontStyle=0" value="&lt;div&gt;标签说明：&lt;/div&gt;&lt;div&gt;L1：while 条件入口&lt;/div&gt;&lt;div&gt;L2：while 循环体入口&lt;/div&gt;&lt;div&gt;L3：if-then 分支入口&lt;/div&gt;&lt;div&gt;L4：if-else 分支入口&lt;/div&gt;&lt;div&gt;L5：if 语句结束位置&lt;/div&gt;&lt;div&gt;L6：while 语句结束位置&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="250" x="590" y="720" as="geometry" />
